# ==============================================================================
# ChatSpic Configuration Template
# ==============================================================================
# Copy this file to '.env' for local environment overrides.
# NEVER commit a real '.env' containing production secrets to source control.
# Real production deployments must use dedicated, securely managed secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONMENT MODE
# ------------------------------------------------------------------------------
# Supported values: 'development', 'production', 'test'
# In 'production' mode, the application enforces strict security validations:
# - A strong SECRET_KEY (>= 32 chars, non-placeholder) is strictly required
# - Wildcard '*' in ALLOWED_ORIGINS is strictly rejected
# - In-memory SQLite databases are strictly rejected
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. JWT & SECURITY SETTINGS
# ------------------------------------------------------------------------------
# SECRET_KEY: Secret key used to sign and verify JWT tokens.
# In development: Unset falls back to a development-only default.
# In production:  STRICTLY REQUIRED. Minimum 32 characters. Must not use
#                 known placeholder values.
# Generate a strong key using:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-secure-random-secret-key

# ALGORITHM: JWT token signing algorithm (default: HS256).
# 'none' algorithm is strictly rejected for security.
ALGORITHM=HS256

# ACCESS_TOKEN_EXPIRE_MINUTES: Access token lifetime in minutes (default: 60).
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# DATABASE_URL: SQLite database connection URL.
# Production must use a persistent file path (e.g. sqlite:///./chat.db).
# In-memory databases ('sqlite:///:memory:') are rejected in production.
DATABASE_URL=sqlite:///./chat.db

# ------------------------------------------------------------------------------
# 4. STORAGE DIRECTORIES
# ------------------------------------------------------------------------------
# UPLOADS_DIR: Directory for user-uploaded files and attachments (default: uploads)
UPLOADS_DIR=uploads

# STATIC_DIR: Directory containing static web assets (default: static)
STATIC_DIR=static

# ------------------------------------------------------------------------------
# 5. BACKUP & RECOVERY (S5-T08)
# ------------------------------------------------------------------------------
# BACKUP_DIR: Directory where SQLite point-in-time snapshots are saved
BACKUP_DIR=backups

# BACKUP_RETENTION_COUNT: Maximum verified backups to retain during pruning (default: 7)
BACKUP_RETENTION_COUNT=7

# ------------------------------------------------------------------------------
# 6. CORS / ALLOWED ORIGINS (S5-T05 / S5-T09)
# ------------------------------------------------------------------------------
# Comma-separated list or JSON array of allowed origins for CORS.
# In development: Defaults to '*' if unset.
# In production:  Wildcard '*' is FORBIDDEN. Explicit origin URLs are required.
# Example: ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 7. LOGGING CONFIGURATION (S5-T07 / S5-T09)
# ------------------------------------------------------------------------------
# Supported levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Production default: INFO (provides operational audit trail without excessive noise).
# Sensitive data (passwords, tokens, hashes) is automatically redacted.
LOG_LEVEL=INFO
