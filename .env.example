# ChatSpic Configuration Template
# Copy this file to .env for local environment overrides.
# Never commit a real .env containing production secrets to source control.

# Environment mode: 'development' or 'production'
ENVIRONMENT=development

# JWT Secret Key (required in production; min 32 characters recommended)
SECRET_KEY=replace-with-a-secure-random-secret-key

# Database connection URL
DATABASE_URL=sqlite:///./chat.db

# Storage directories
UPLOADS_DIR=uploads
STATIC_DIR=static

# Allowed CORS origins (comma-separated or JSON list)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
